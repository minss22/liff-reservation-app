# LIFF 앱 ID (LINE Developers Console에서 발급)
VITE_LIFF_ID=1234567890-xxxxxxxxZ

# 백엔드 API 서버 URL
VITE_API_BASE_URL=https://your-api-server.com/api

# 병원 채널 ID (branches 시트의 branch_id 와 일치) — 기본/폴백 값
# 멀티 병원: 리치 메뉴 URL 에 ?branch=<branch_id> 를 붙이면 그 값이 우선한다
#   예) https://liff.line.me/{liffId}?branch=2008835257
VITE_BRANCH_ID=clinicbridge
